{
  "id": "root",
  "version": "0.13.0",
  "type": "SurfaceContainers",
  "attrs": {
    "title": "\"Surface containers example\""
  },
  "children": [
    {
      "id": "summaryCard",
      "type": "SurfaceContainers",
      "attrs": {
        "uses.title": "\"Summary\"",
        "uses.elevation": "2"
      }
    },
    {
      "id": "tile",
      "type": "SurfaceContainers"
    },
    {
      "id": "labelledGroup",
      "type": "SurfaceContainers"
    },
    {
      "id": "checkableGroup",
      "type": "SurfaceContainers"
    },
    {
      "id": "heroBanner",
      "type": "SurfaceContainers"
    },
    {
      "id": "notificationsGroup",
      "type": "SurfaceContainers",
      "attrs": {
        "uses.title": "\"Notifications\"",
        "uses.checkable": "true",
        "uses.checked": "notificationsEnabled"
      },
      "children": [
        {
          "id": "notificationsContent",
          "type": "section",
          "attrs": {
            "text": "\"Choose what to be told.\""
          }
        },
        {
          "id": "notificationsActions",
          "type": "footer",
          "children": [
            {
              "id": "notificationsSave",
              "type": "ActionControls",
              "attrs": {
                "uses.label": "\"Save\"",
                "produces.activate": "saveNotifications()"
              }
            }
          ]
        }
      ]
    }
  ]
}
