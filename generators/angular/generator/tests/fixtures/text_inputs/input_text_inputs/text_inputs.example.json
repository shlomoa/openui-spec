{
  "id": "root",
  "version": "0.13.0",
  "type": "TextInputs",
  "attrs": {
    "title": "\"Text inputs example\""
  },
  "children": [
    {
      "id": "searchText",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"Search\"",
        "uses.placeholder": "\"Type to search\"",
        "uses.value": "query",
        "produces.valueChange": "onQueryChange($event)"
      }
    },
    {
      "id": "commentField",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"Comment\"",
        "uses.multiline": "true",
        "uses.maxLength": "500",
        "uses.required": "true",
        "uses.readOnly": "false",
        "uses.disabled": "false",
        "produces.valueChange": "onCommentChange($event)"
      }
    },
    {
      "id": "passwordField",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"Password\"",
        "uses.type": "\"password\""
      }
    },
    {
      "id": "richTextEditor",
      "type": "TextInputs"
    },
    {
      "id": "keyboardShortcutField",
      "type": "TextInputs"
    },
    {
      "id": "metadataDrivenField",
      "type": "TextInputs"
    }
  ]
}
