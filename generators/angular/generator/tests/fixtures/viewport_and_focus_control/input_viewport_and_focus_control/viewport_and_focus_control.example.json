{
  "id": "root",
  "version": "0.13.0",
  "type": "ViewportAndFocusControl",
  "attrs": {
    "title": "\"Viewport and focus control example\""
  },
  "children": [
    {
      "id": "messageLog",
      "type": "StructuralContainers",
      "attrs": {
        "uses.ariaLabel": "\"Message log\""
      }
    },
    {
      "id": "viewportScrolling",
      "type": "ViewportAndFocusControl",
      "attrs": {
        "uses.target": "\"messageLog\""
      }
    },
    {
      "id": "scrollLock",
      "type": "ViewportAndFocusControl",
      "attrs": {
        "uses.target": "\"messageLog\""
      }
    },
    {
      "id": "focusManagement",
      "type": "ViewportAndFocusControl",
      "attrs": {
        "uses.target": "\"messageLog\""
      }
    },
    {
      "id": "messageLogViewport",
      "type": "ViewportAndFocusControl",
      "attrs": {
        "uses.target": "\"messageLog\"",
        "uses.axis": "\"vertical\"",
        "uses.kinetic": "true",
        "uses.scrollLock": "true",
        "behaves.scrollTo": "scrollToLatest()",
        "behaves.reveal": "revealMessage(messageId)",
        "produces.scroll": "onMessageLogScroll($event)"
      }
    },
    {
      "id": "messageLogFocus",
      "type": "ViewportAndFocusControl",
      "attrs": {
        "uses.target": "\"messageLog\"",
        "behaves.focus": "focusLatestMessage()"
      }
    }
  ]
}
