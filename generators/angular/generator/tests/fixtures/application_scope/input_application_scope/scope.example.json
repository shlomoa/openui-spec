{
  "id": "root",
  "version": "0.10.0",
  "type": "Application",
  "children": [
    {
      "id": "appHost",
      "type": "html",
      "attrs": {
        "uses.lang": "\"en\"",
        "uses.dir": "\"ltr\"",
        "uses.title": "\"Application bootstrap example\""
      },
      "children": [
        {
          "id": "documentHead",
          "type": "head"
        },
        {
          "id": "documentBody",
          "type": "body"
        }
      ]
    },
    {
      "id": "appFavicon",
      "type": "link",
      "attrs": {
        "uses.rel": "\"icon\"",
        "uses.href": "\"/favicon.ico\""
      }
    },
    {
      "id": "appRouting",
      "type": "Routing",
      "attrs": {
        "uses.defaultRoute": "\"homeRoute\""
      },
      "children": [
        {
          "id": "homeRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"home\"",
            "uses.target": "\"homePage\"",
            "uses.title": "\"Home\""
          }
        }
      ]
    },
    {
      "id": "appNavigation",
      "type": "Navigation",
      "attrs": {
        "uses.ariaLabel": "\"Primary\""
      },
      "children": [
        {
          "id": "navHome",
          "type": "NavItem",
          "attrs": {
            "uses.label": "\"Home\"",
            "uses.route": "\"homeRoute\"",
            "uses.icon": "\"home\""
          }
        }
      ]
    },
    {
      "id": "appToolbar",
      "type": "ToolBar",
      "attrs": {
        "uses.ariaLabel": "\"Application commands\""
      },
      "children": [
        {
          "id": "toolbarRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "helpAction",
              "type": "ToolAction",
              "attrs": {
                "uses.label": "\"Help\"",
                "uses.icon": "\"help\"",
                "produces.activate": "openHelp()"
              }
            },
            {
              "id": "homePage",
              "type": "EmptyPage"
            }
          ]
        }
      ]
    },
    {
      "id": "shellBar",
      "type": "Application"
    }
  ]
}
