{
  "id": "root",
  "version": "0.11.0",
  "type": "Application",
  "children": [
    {
      "id": "homeRoute",
      "type": "Route",
      "attrs": {
        "uses.path": "\"home\"",
        "uses.target": "\"homePage\"",
        "uses.title": "\"Home\""
      }
    },
    {
      "id": "reportsRoute",
      "type": "Route",
      "attrs": {
        "uses.path": "\"reports\"",
        "uses.target": "\"reportsPage\"",
        "uses.title": "\"Reports\""
      }
    },
    {
      "id": "primaryNav",
      "type": "Navigation",
      "attrs": {
        "uses.ariaLabel": "\"Primary\""
      },
      "children": [
        {
          "id": "navHome",
          "type": "NavItem",
          "attrs": {
            "uses.label": "\"Home\"",
            "uses.route": "\"homeRoute\"",
            "uses.icon": "\"home\""
          }
        },
        {
          "id": "navReportsGroup",
          "type": "NavGroup",
          "attrs": {
            "uses.label": "\"Reports\"",
            "uses.expanded": true
          },
          "children": [
            {
              "id": "navSalesReport",
              "type": "NavItem",
              "attrs": {
                "uses.label": "\"Sales\"",
                "uses.route": "\"reportsRoute\""
              }
            },
            {
              "id": "navAuditReport",
              "type": "NavItem",
              "attrs": {
                "uses.label": "\"Audit\"",
                "uses.route": "\"reportsRoute\"",
                "uses.disabled": true
              }
            }
          ]
        },
        {
          "id": "navAdmin",
          "type": "NavItem",
          "attrs": {
            "uses.label": "\"Administration\"",
            "uses.route": "\"homeRoute\"",
            "uses.icon": "\"settings\""
          }
        }
      ]
    },
    {
      "id": "homePage",
      "type": "EmptyPage"
    },
    {
      "id": "reportsPage",
      "type": "Report"
    }
  ]
}
