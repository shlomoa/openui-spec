{
  "id": "root",
  "version": "0.10.0",
  "type": "Stepper",
  "attrs": {
    "title": "\"Stepper example\""
  },
  "children": [
    {
      "id": "checkoutStepper",
      "type": "Stepper",
      "attrs": {
        "uses.linear": true,
        "uses.selectedIndex": 0,
        "produces.selectionChange": "onStepChange($event)",
        "produces.complete": "onComplete()"
      },
      "children": [
        {
          "id": "cartStep",
          "type": "step"
        },
        {
          "id": "shippingStep",
          "type": "step"
        },
        {
          "id": "paymentStep",
          "type": "step"
        }
      ]
    },
    {
      "id": "wizard",
      "type": "Stepper",
      "children": [
        {
          "id": "wizardStep",
          "type": "step"
        }
      ]
    }
  ]
}
