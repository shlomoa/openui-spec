{
  "id": "root",
  "version": "0.5.0",
  "type": "Stepper",
  "attrs": {
    "title": "\"Stepper example\""
  },
  "children": [
    {
      "id": "checkoutStepper",
      "type": "Stepper",
      "attrs": {
        "uses.linear": true,
        "uses.selectedIndex": 0,
        "produces.stepChange": "onStepChange($event)",
        "produces.completed": "onComplete()"
      },
      "children": [
        {
          "id": "cartStep",
          "type": "step",
          "attrs": {
            "uses.label": "\"Cart\"",
            "uses.order": 1,
            "uses.completed": true
          }
        },
        {
          "id": "shippingStep",
          "type": "step",
          "attrs": {
            "uses.label": "\"Shipping\"",
            "uses.order": 2,
            "uses.invalid": "shippingForm.invalid"
          }
        },
        {
          "id": "paymentStep",
          "type": "step",
          "attrs": {
            "uses.label": "\"Payment\"",
            "uses.order": 3
          }
        },
        {
          "id": "stepperSubmit",
          "type": "ActionControls",
          "attrs": {
            "text": "\"Place order\"",
            "uses.disabled": "!allStepsValid",
            "produces.click": "submit()"
          }
        }
      ]
    }
  ]
}
