{
  "id": "root",
  "version": "0.13.0",
  "type": "List",
  "attrs": {
    "title": "\"List example\""
  },
  "children": [
    {
      "id": "taskList",
      "type": "List",
      "attrs": {
        "uses.items": "tasks",
        "behaves.sort": null,
        "behaves.filter": "searchTerm",
        "uses.selection": "\"single\"",
        "uses.loading": "isLoading",
        "uses.error": "loadError",
        "produces.selectionChange": "onSelect($event)",
        "behaves.paginate": "paginateTasks($event)"
      },
      "children": [
        {
          "id": "taskItem",
          "type": "li",
          "attrs": {
            "uses.label": "item.title",
            "uses.description": "item.due"
          }
        },
        {
          "id": "listMore",
          "type": "ActionControls",
          "attrs": {
            "uses.hasMore": "hasMore",
            "produces.activate": "onLoadMore()"
          }
        },
        {
          "id": "listEmpty",
          "type": "FeedbackWidgets",
          "attrs": {
            "uses.message": "\"No tasks.\""
          }
        }
      ]
    },
    {
      "id": "groceryList",
      "type": "ul",
      "attrs": {
        "uses.selection": "\"none\""
      },
      "children": [
        {
          "id": "groceryItem",
          "type": "li",
          "attrs": {
            "uses.label": "\"Bread\""
          }
        }
      ]
    },
    {
      "id": "tree",
      "type": "List"
    },
    {
      "id": "tokenCollection",
      "type": "List"
    },
    {
      "id": "editableChipCollection",
      "type": "List"
    },
    {
      "id": "descriptionList",
      "type": "List"
    },
    {
      "id": "iconCollection",
      "type": "List"
    }
  ]
}
