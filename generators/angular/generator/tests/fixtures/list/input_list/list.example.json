{
  "id": "root",
  "version": "0.6.0",
  "type": "List",
  "attrs": {
    "title": "\"List example\""
  },
  "children": [
    {
      "id": "taskList",
      "type": "List",
      "attrs": {
        "uses.items": "tasks",
        "uses.sort": "\"dueDate asc\"",
        "uses.filter": "searchTerm",
        "uses.selection": "\"single\"",
        "uses.loading": "isLoading",
        "uses.error": "loadError",
        "produces.selectionChange": "onSelect($event)"
      },
      "children": [
        {
          "id": "taskItem",
          "type": "li",
          "attrs": {
            "uses.label": "item.title",
            "uses.description": "item.due"
          }
        },
        {
          "id": "listMore",
          "type": "ActionControls",
          "attrs": {
            "uses.hasMore": "hasMore",
            "produces.loadMore": "onLoadMore()"
          }
        },
        {
          "id": "listEmpty",
          "type": "FeedbackWidgets",
          "attrs": {
            "uses.message": "\"No tasks.\""
          }
        }
      ]
    }
  ]
}
