{
  "id": "root",
  "version": "0.8.0",
  "type": "DateTimePickers",
  "attrs": {
    "title": "\"Date/time picker example\""
  },
  "children": [
    {
      "id": "appointmentPicker",
      "type": "DateTimePicker",
      "attrs": {
        "uses.start": "appointmentStart",
        "uses.end": "appointmentEnd",
        "produces.dateChange": "onDateChange($event)"
      }
    },
    {
      "id": "dateField",
      "type": "DateTimePicker"
    },
    {
      "id": "timeField",
      "type": "DateTimePicker"
    },
    {
      "id": "dateAndTimeField",
      "type": "DateTimePicker"
    }
  ]
}
