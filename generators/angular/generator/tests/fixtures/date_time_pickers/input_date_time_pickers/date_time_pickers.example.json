{
  "id": "root",
  "version": "0.6.0",
  "type": "DateTimePickers",
  "attrs": {
    "title": "\"Date/time picker example\""
  },
  "children": [
    {
      "id": "appointmentPicker",
      "type": "DateTimePicker",
      "attrs": {
        "uses.min": "\"2026-01-01\"",
        "uses.max": "\"2026-12-31\"",
        "uses.matDatepickerFilter": "isBusinessDay",
        "uses.displayFormat": "\"yyyy-MM-dd HH:mm\"",
        "uses.parseFormat": "\"yyyy-MM-dd HH:mm\"",
        "uses.required": true,
        "uses.ariaLabel": "\"Appointment date and time\"",
        "produces.dateChange": "onDateChange($event)"
      },
      "children": [
        {
          "id": "appointmentDate",
          "type": "input",
          "attrs": {
            "matInput": null,
            "type": "\"date\"",
            "placeholder": "\"Date\"",
            "formControlName": "\"date\""
          }
        },
        {
          "id": "appointmentTime",
          "type": "input",
          "attrs": {
            "matInput": null,
            "type": "\"time\"",
            "placeholder": "\"Time\"",
            "formControlName": "\"time\""
          }
        }
      ]
    }
  ]
}
