{
  "id": "root",
  "version": "0.5.0",
  "type": "Widgets",
  "attrs": {
    "title": "\"Widgets example\""
  },
  "children": [
    {
      "id": "salesChart",
      "type": "Chart",
      "attrs": {
        "uses.chartType": "\"bar\"",
        "uses.series": "salesSeries",
        "uses.ariaLabel": "\"Sales by month\""
      }
    },
    {
      "id": "salesTable",
      "type": "table",
      "attrs": {
        "uses.data": "sales"
      },
      "children": [
        {
          "id": "colMonth",
          "type": "Table",
          "attrs": {
            "uses.field": "\"month\"",
            "uses.header": "\"Month\""
          }
        }
      ]
    },
    {
      "id": "ordersGrid",
      "type": "DataGrid",
      "attrs": {
        "uses.data": "orders",
        "uses.sortable": true
      }
    },
    {
      "id": "recentList",
      "type": "List",
      "attrs": {
        "uses.items": "recent"
      },
      "children": [
        {
          "id": "recentItem",
          "type": "li",
          "attrs": {
            "uses.label": "item.title"
          }
        }
      ]
    },
    {
      "id": "saveFeedback",
      "type": "FeedbackWidgets",
      "attrs": {
        "uses.message": "\"Saved successfully.\""
      }
    },
    {
      "id": "productMedia",
      "type": "MediaWidgets",
      "attrs": {
        "uses.src": "\"/media/product.mp4\"",
        "uses.controls": true
      }
    },
    {
      "id": "sectionNavigation",
      "type": "NavigationWidgets",
      "attrs": {
        "uses.ariaLabel": "\"Sections\""
      }
    },
    {
      "id": "rowActionsMenu",
      "type": "MenuWidgets",
      "attrs": {
        "uses.label": "\"Row actions\"",
        "uses.open": "isMenuOpen"
      }
    },
    {
      "id": "rangePicker",
      "type": "DateTimePicker",
      "attrs": {
        "uses.rangePicker": "\"picker\""
      },
      "children": [
        {
          "id": "rangeStart",
          "type": "input",
          "attrs": {
            "matStartDate": null,
            "placeholder": "\"Start\""
          }
        },
        {
          "id": "rangeEnd",
          "type": "input",
          "attrs": {
            "matEndDate": null,
            "placeholder": "\"End\""
          }
        }
      ]
    },
    {
      "id": "wizard",
      "type": "Stepper",
      "attrs": {
        "uses.linear": true
      },
      "children": [
        {
          "id": "stepOne",
          "type": "step",
          "attrs": {
            "uses.label": "\"Step 1\""
          }
        }
      ]
    },
    {
      "id": "infoDialog",
      "type": "Dialog",
      "attrs": {
        "uses.modal": true,
        "uses.open": "showInfo"
      },
      "children": [
        {
          "id": "infoTitle",
          "type": "header",
          "attrs": {
            "text": "\"Info\""
          }
        }
      ]
    }
  ]
}
