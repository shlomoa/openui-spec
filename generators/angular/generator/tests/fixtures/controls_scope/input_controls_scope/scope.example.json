{
  "id": "root",
  "version": "0.13.0",
  "type": "Controls",
  "attrs": {
    "title": "\"Controls example\""
  },
  "children": [
    {
      "id": "nativeControls",
      "type": "Native",
      "children": [
        {
          "id": "colorScheme",
          "type": "Native",
          "attrs": {
            "uses.supported": "\"light dark\""
          }
        },
        {
          "id": "scrollRegion",
          "type": "Native",
          "attrs": {
            "uses.overflow": "\"auto\""
          }
        }
      ]
    },
    {
      "id": "primaryAction",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Save\"",
        "produces.activate": "save()"
      }
    },
    {
      "id": "searchText",
      "type": "TextInputs",
      "attrs": {
        "uses.placeholder": "\"Search\"",
        "uses.value": "query"
      }
    },
    {
      "id": "shippingChoice",
      "type": "ChoiceControls",
      "attrs": {
        "uses.value": "shippingSpeed"
      }
    },
    {
      "id": "accentPicker",
      "type": "PickerControl",
      "attrs": {
        "uses.value": "accentColor"
      }
    },
    {
      "id": "volumeRange",
      "type": "RangeControl",
      "attrs": {
        "uses.min": "0",
        "uses.max": "100",
        "uses.value": "volume"
      }
    },
    {
      "id": "signatureCapture",
      "type": "DrawingAndCapture",
      "attrs": {
        "uses.mode": "\"draw\""
      }
    },
    {
      "id": "statusLabel",
      "type": "DisplayPrimitives",
      "attrs": {
        "uses.text": "\"Ready\""
      }
    },
    {
      "id": "syncStatus",
      "type": "StatusIndicator",
      "attrs": {
        "uses.mode": "\"indeterminate\""
      }
    },
    {
      "id": "skipToContent",
      "type": "LinkAndScrollControls",
      "attrs": {
        "uses.href": "\"#main\""
      }
    },
    {
      "id": "summaryTable",
      "type": "table",
      "children": [
        {
          "id": "summaryRow",
          "type": "tr",
          "children": [
            {
              "id": "summaryHeader",
              "type": "DisplayPrimitives",
              "attrs": {
                "uses.scope": "\"row\""
              }
            },
            {
              "id": "summaryValue",
              "type": "DisplayPrimitives"
            }
          ]
        }
      ]
    }
  ]
}
