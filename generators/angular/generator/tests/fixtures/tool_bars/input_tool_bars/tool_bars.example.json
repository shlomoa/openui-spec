{
  "id": "root",
  "version": "0.3.1",
  "type": "Application",
  "children": [
    {
      "id": "appToolbar",
      "type": "ToolBar",
      "attrs": {
        "[ariaLabel]": "\"Application commands\""
      },
      "children": [
        {
          "id": "primaryRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "newAction",
              "type": "ToolAction",
              "attrs": {
                "[label]": "\"New\"",
                "[icon]": "\"add\"",
                "(activate)": "createNew()"
              }
            },
            {
              "id": "saveAction",
              "type": "ToolAction",
              "attrs": {
                "[label]": "\"Save\"",
                "[icon]": "\"save\"",
                "(activate)": "save()"
              }
            }
          ]
        },
        {
          "id": "secondaryRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "deleteAction",
              "type": "ToolAction",
              "attrs": {
                "[label]": "\"Delete\"",
                "[icon]": "\"delete\"",
                "[disabled]": "true",
                "(activate)": "deleteSelected()"
              }
            }
          ]
        }
      ]
    }
  ]
}
