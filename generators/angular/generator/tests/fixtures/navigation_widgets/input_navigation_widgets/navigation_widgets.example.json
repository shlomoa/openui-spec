{
  "id": "root",
  "version": "0.12.0",
  "type": "NavigationWidgets",
  "attrs": {
    "title": "\"Navigation widgets example\""
  },
  "children": [
    {
      "id": "sectionNavigation",
      "type": "NavigationWidgets",
      "attrs": {
        "uses.ariaLabel": "\"Sections\"",
        "uses.selected": "\"overview\"",
        "uses.orientation": "\"vertical\"",
        "produces.selectionChange": "onSectionChange($event)"
      }
    },
    {
      "id": "resultsPager",
      "type": "NavigationWidgets",
      "attrs": {
        "uses.ariaLabel": "\"Result pages\"",
        "uses.pageSize": "25",
        "uses.total": "rowCount",
        "produces.pageChange": "onPageChange($event)"
      }
    },
    {
      "id": "columnBrowser",
      "type": "NavigationWidgets"
    }
  ]
}
