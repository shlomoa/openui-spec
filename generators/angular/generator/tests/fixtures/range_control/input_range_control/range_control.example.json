{
  "id": "root",
  "version": "0.10.0",
  "type": "RangeControl",
  "attrs": {
    "title": "\"Range control example\""
  },
  "children": [
    {
      "id": "volumeRange",
      "type": "RangeControl",
      "attrs": {
        "uses.label": "\"Volume\"",
        "uses.min": 0,
        "uses.max": 100,
        "uses.value": "volume",
        "produces.valueChange": "setVolume($event)"
      }
    },
    {
      "id": "rangeSlider",
      "type": "RangeControl"
    },
    {
      "id": "rotaryValueControl",
      "type": "RangeControl"
    }
  ]
}
