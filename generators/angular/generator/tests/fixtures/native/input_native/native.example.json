{
  "id": "root",
  "version": "0.9.0",
  "type": "Native",
  "attrs": {
    "title": "\"Native controls example\""
  },
  "children": [
    {
      "id": "colorScheme",
      "type": "Native",
      "attrs": {
        "uses.supported": "\"light dark\"",
        "uses.default": "\"light\""
      }
    },
    {
      "id": "typography",
      "type": "Native",
      "attrs": {
        "uses.fontFamily": "\"system-ui, sans-serif\"",
        "uses.fontSize": "\"16px\""
      }
    },
    {
      "id": "scrollRegion",
      "type": "Native",
      "attrs": {
        "uses.overflow": "\"auto\"",
        "uses.scrollBehavior": "\"smooth\""
      }
    },
    {
      "id": "focusRing",
      "type": "Native",
      "attrs": {
        "uses.focusVisible": true,
        "uses.tabIndex": 0
      }
    }
  ]
}
