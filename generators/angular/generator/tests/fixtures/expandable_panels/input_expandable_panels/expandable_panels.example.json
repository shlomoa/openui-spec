{
  "id": "root",
  "version": "0.12.0",
  "type": "ExpandablePanels",
  "attrs": {
    "title": "\"Expandable panels example\""
  },
  "children": [
    {
      "id": "settingsAccordion",
      "type": "ExpandablePanels",
      "attrs": {
        "uses.multi": "false"
      },
      "children": [
        {
          "id": "settingsAccordionSummary",
          "type": "summary"
        },
        {
          "id": "generalPanel",
          "type": "ExpandablePanels",
          "attrs": {
            "uses.heading": "\"General\"",
            "uses.expanded": "true",
            "uses.defaultExpanded": "true",
            "produces.expandedChange": "onToggle('general', $event)"
          },
          "children": [
            {
              "id": "generalPanelSummary",
              "type": "summary"
            },
            {
              "id": "generalContent",
              "type": "section",
              "attrs": {
                "text": "\"General settings\""
              }
            }
          ]
        },
        {
          "id": "advancedPanel",
          "type": "ExpandablePanels",
          "attrs": {
            "uses.heading": "\"Advanced\"",
            "uses.expanded": "false",
            "uses.ariaControls": "\"advancedContent\""
          },
          "children": [
            {
              "id": "advancedPanelSummary",
              "type": "summary"
            },
            {
              "id": "advancedContent",
              "type": "section",
              "attrs": {
                "text": "\"Advanced settings\""
              }
            }
          ]
        }
      ]
    },
    {
      "id": "disclosure",
      "type": "ExpandablePanels",
      "children": [
        {
          "id": "disclosureSummary",
          "type": "summary"
        }
      ]
    },
    {
      "id": "releaseNotesPanel",
      "type": "details",
      "attrs": {
        "uses.expanded": "false",
        "behaves.expand": "expandReleaseNotes()",
        "behaves.collapse": "collapseReleaseNotes()",
        "produces.expandedChange": "onReleaseNotesToggle($event)"
      },
      "children": [
        {
          "id": "releaseNotesSummary",
          "type": "summary"
        },
        {
          "id": "releaseNotesContent",
          "type": "section",
          "attrs": {
            "text": "\"Release notes\""
          }
        }
      ]
    }
  ]
}
