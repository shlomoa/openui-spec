{
  "id": "root",
  "version": "0.8.0",
  "type": "DataGrid",
  "attrs": {
    "title": "\"Data grid example\""
  },
  "children": [
    {
      "id": "ordersGrid",
      "type": "DataGrid",
      "attrs": {
        "uses.data": "orders",
        "uses.selection": "\"multiple\"",
        "uses.sortable": true,
        "produces.selectionChange": "onOrderSelection($event)"
      }
    },
    {
      "id": "treeGrid",
      "type": "DataGrid"
    }
  ]
}
