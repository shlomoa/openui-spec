{
  "id": "root",
  "version": "0.6.0",
  "type": "Containers",
  "attrs": {
    "title": "\"Containers example\""
  },
  "children": [
    {
      "id": "layoutGrid",
      "type": "Grid",
      "attrs": {
        "uses.columns": 12,
        "uses.responsive": true
      },
      "children": [
        {
          "id": "mainItem",
          "type": "section",
          "attrs": {
            "uses.colSpan": 8
          },
          "children": [
            {
              "id": "detailTabs",
              "type": "Tabs",
              "attrs": {
                "uses.selectedIndex": 0
              },
              "children": [
                {
                  "id": "overviewTab",
                  "type": "tab",
                  "attrs": {
                    "uses.label": "\"Overview\""
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sideItem",
          "type": "section",
          "attrs": {
            "uses.colSpan": 4
          },
          "children": [
            {
              "id": "filtersPanel",
              "type": "ExpandablePanels",
              "attrs": {
                "uses.heading": "\"Filters\"",
                "uses.expanded": true
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summaryCard",
      "type": "SurfaceContainers",
      "attrs": {
        "uses.label": "\"Summary\"",
        "uses.elevation": 2
      }
    },
    {
      "id": "filterSheet",
      "type": "SheetContainers",
      "attrs": {
        "uses.position": "\"bottom\"",
        "uses.open": "showFilters"
      }
    },
    {
      "id": "helpOverlay",
      "type": "OverlayContainers",
      "attrs": {
        "uses.anchor": "\"helpButton\"",
        "uses.open": "showHelp"
      }
    },
    {
      "id": "mainArticle",
      "type": "StructuralContainers",
      "attrs": {
        "uses.role": "\"article\""
      }
    },
    {
      "id": "workspaceSplitter",
      "type": "Splitters",
      "attrs": {
        "uses.orientation": "\"horizontal\"",
        "uses.position": 320
      }
    },
    {
      "id": "flexibleColumnLayout",
      "type": "Containers"
    }
  ]
}
