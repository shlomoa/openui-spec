{
  "id": "root",
  "version": "0.10.0",
  "type": "Containers",
  "attrs": {
    "title": "\"Containers example\""
  },
  "children": [
    {
      "id": "layoutGrid",
      "type": "Grid",
      "attrs": {
        "uses.columns": 12
      },
      "children": [
        {
          "id": "mainItem",
          "type": "section",
          "children": [
            {
              "id": "detailTabs",
              "type": "Tabs",
              "attrs": {
                "uses.selectedIndex": 0
              },
              "children": [
                {
                  "id": "overviewTab",
                  "type": "tab"
                }
              ]
            }
          ]
        },
        {
          "id": "sideItem",
          "type": "section",
          "children": [
            {
              "id": "filtersPanel",
              "type": "ExpandablePanels",
              "attrs": {
                "uses.expanded": true
              },
              "children": [
                {
                  "id": "filtersPanelSummary",
                  "type": "summary"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "summaryCard",
      "type": "SurfaceContainers",
      "attrs": {
        "uses.title": "\"Summary\""
      }
    },
    {
      "id": "filterSheet",
      "type": "SheetContainers",
      "attrs": {
        "uses.position": "\"bottom\"",
        "uses.open": "showFilters"
      }
    },
    {
      "id": "helpOverlay",
      "type": "OverlayContainers",
      "attrs": {
        "uses.anchor": "\"helpButton\"",
        "uses.open": "showHelp"
      }
    },
    {
      "id": "helpButton",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Help\""
      }
    },
    {
      "id": "mainArticle",
      "type": "StructuralContainers"
    },
    {
      "id": "workspaceSplitter",
      "type": "Splitters",
      "attrs": {
        "uses.orientation": "\"horizontal\""
      },
      "children": [
        {
          "id": "workspaceSplitterPane",
          "type": "section"
        }
      ]
    },
    {
      "id": "flexibleColumnLayout",
      "type": "Containers"
    }
  ]
}
