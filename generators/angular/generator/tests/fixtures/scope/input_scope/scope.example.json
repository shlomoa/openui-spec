{
  "id": "root",
  "version": "0.11.0",
  "type": "Application",
  "attrs": {
    "size": "\"1960x1080\""
  },
  "children": [
    {
      "id": "appRouting",
      "type": "Routing",
      "attrs": {
        "uses.defaultRoute": "\"dashboardRoute\""
      },
      "children": [
        {
          "id": "dashboardRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"dashboard\"",
            "uses.target": "\"dashboardPage\"",
            "uses.title": "\"Dashboard\""
          }
        },
        {
          "id": "ordersRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"orders\"",
            "uses.target": "\"ordersReport\"",
            "uses.title": "\"Orders\""
          }
        }
      ]
    },
    {
      "id": "appNavigation",
      "type": "Navigation",
      "attrs": {
        "uses.ariaLabel": "\"Primary\""
      },
      "children": [
        {
          "id": "navDashboard",
          "type": "NavItem",
          "attrs": {
            "uses.label": "\"Dashboard\"",
            "uses.route": "\"dashboardRoute\"",
            "uses.icon": "\"dashboard\""
          }
        },
        {
          "id": "navOrders",
          "type": "NavItem",
          "attrs": {
            "uses.label": "\"Orders\"",
            "uses.route": "\"ordersRoute\""
          }
        }
      ]
    },
    {
      "id": "appToolbar",
      "type": "ToolBar",
      "attrs": {
        "uses.ariaLabel": "\"Order commands\""
      },
      "children": [
        {
          "id": "appToolbarRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "newOrderAction",
              "type": "ToolAction",
              "attrs": {
                "uses.label": "\"New order\"",
                "uses.icon": "\"add\"",
                "produces.activate": "onNewOrder()"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "dashboardPage",
      "type": "DashboardPage"
    },
    {
      "id": "ordersReport",
      "type": "Report",
      "attrs": {
        "title": "\"Orders\""
      }
    }
  ]
}
