{
  "id": "root",
  "version": "0.12.0",
  "type": "InputAssistance",
  "attrs": {
    "title": "\"Input assistance example\""
  },
  "children": [
    {
      "id": "emailField",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"E-mail\"",
        "uses.value": "email",
        "produces.valueChange": "onEmailChange($event)"
      }
    },
    {
      "id": "textCompletion",
      "type": "InputAssistance",
      "attrs": {
        "uses.target": "\"emailField\""
      }
    },
    {
      "id": "constraintValidation",
      "type": "InputAssistance",
      "attrs": {
        "uses.target": "\"emailField\""
      }
    },
    {
      "id": "emailSuggestionAssist",
      "type": "InputAssistance",
      "attrs": {
        "uses.target": "\"emailField\"",
        "uses.suggestions": ["\"ann@example.com\"", "\"ben@example.com\""],
        "produces.suggestionSelect": "onSuggestionSelect($event)"
      }
    },
    {
      "id": "emailPatternCheck",
      "type": "InputAssistance",
      "attrs": {
        "uses.target": "\"emailField\"",
        "uses.pattern": "\"^.+@.+$\"",
        "produces.invalid": "onEmailInvalid($event)"
      }
    }
  ]
}
