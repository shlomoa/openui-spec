{
  "id": "root",
  "version": "0.12.0",
  "type": "Form",
  "attrs": {
    "title": "\"Customer form\"",
    "uses.dirty": "form.dirty",
    "uses.loading": "isSaving",
    "uses.error": "saveError",
    "behaves.submit": "onSubmit(form.value)"
  },
  "children": [
    {
      "id": "nameField",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"Name\"",
        "uses.required": true,
        "uses.maxLength": 80,
        "uses.value": "form.name",
        "produces.valueChange": "onChange('name', $event)"
      }
    },
    {
      "id": "emailField",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"Email\"",
        "uses.required": true,
        "uses.pattern": "\"^.+@.+$\"",
        "uses.error": "\"Enter a valid email\""
      }
    },
    {
      "id": "submitButton",
      "type": "ActionControls",
      "attrs": {
        "uses.disabled": "form.invalid",
        "uses.label": "\"Save\"",
        "produces.activate": "onSubmit(form.value)"
      }
    },
    {
      "id": "cancelButton",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Cancel\"",
        "produces.activate": "onReset()"
      }
    },
    {
      "id": "formField",
      "type": "Form"
    },
    {
      "id": "formGroup",
      "type": "Form"
    }
  ]
}
