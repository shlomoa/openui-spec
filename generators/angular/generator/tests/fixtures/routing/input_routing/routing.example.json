{
  "id": "root",
  "version": "0.8.0",
  "type": "Application",
  "children": [
    {
      "id": "appRouting",
      "type": "Routing",
      "attrs": {
        "uses.defaultRoute": "\"dashboardRoute\""
      },
      "children": [
        {
          "id": "dashboardRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"dashboard\"",
            "uses.target": "\"dashboardPage\"",
            "uses.title": "\"Dashboard\"",
            "uses.access": "\"authenticated\""
          }
        },
        {
          "id": "reportRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"reports\"",
            "uses.target": "\"reportPage\"",
            "uses.title": "\"Reports\"",
            "uses.access": "\"report-reader\""
          }
        },
        {
          "id": "fallbackRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"**\"",
            "uses.redirectTo": "\"dashboardRoute\""
          }
        }
      ]
    },
    {
      "id": "dashboardPage",
      "type": "DashboardPage"
    },
    {
      "id": "reportPage",
      "type": "Report"
    }
  ]
}
