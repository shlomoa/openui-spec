{
  "id": "root",
  "version": "0.12.0",
  "type": "Application",
  "children": [
    {
      "id": "dashboardRoute",
      "type": "Route",
      "attrs": {
        "uses.path": "\"dashboard\"",
        "uses.target": "\"dashboardPage\"",
        "uses.title": "\"Dashboard\"",
        "uses.access": "\"authenticated\""
      },
      "children": [
        {
          "id": "dashboardSettingsRoute",
          "type": "Route",
          "attrs": {
            "uses.path": "\"settings\"",
            "uses.target": "\"settingsPage\"",
            "uses.title": "\"Settings\""
          }
        }
      ]
    },
    {
      "id": "dashboardPage",
      "type": "DashboardPage"
    },
    {
      "id": "settingsPage",
      "type": "EmptyPage"
    }
  ]
}
