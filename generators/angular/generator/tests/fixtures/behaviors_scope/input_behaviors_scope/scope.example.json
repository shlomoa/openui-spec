{
  "id": "root",
  "version": "0.9.0",
  "type": "Behaviors",
  "attrs": {
    "title": "\"Behaviors example\""
  },
  "children": [
    {
      "id": "workspacePanel",
      "type": "SurfaceContainers",
      "attrs": {
        "uses.title": "\"Workspace\""
      }
    },
    {
      "id": "panelCollapsible",
      "type": "Collapsible",
      "attrs": {
        "uses.target": "\"workspacePanel\""
      }
    },
    {
      "id": "panelResizable",
      "type": "Resizable",
      "attrs": {
        "uses.target": "\"workspacePanel\""
      }
    },
    {
      "id": "panelDnd",
      "type": "DragAndDrop",
      "attrs": {
        "uses.target": "\"workspacePanel\""
      }
    },
    {
      "id": "searchQuery",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"Search\"",
        "uses.value": "query"
      }
    },
    {
      "id": "searchCompletion",
      "type": "InputAssistance",
      "attrs": {
        "uses.target": "\"searchQuery\""
      }
    },
    {
      "id": "workspaceFocus",
      "type": "ViewportAndFocusControl",
      "attrs": {
        "uses.target": "\"workspacePanel\""
      }
    },
    {
      "id": "workspaceModality",
      "type": "ModalOverlay",
      "attrs": {
        "uses.target": "\"workspacePanel\""
      }
    }
  ]
}
