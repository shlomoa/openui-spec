{
  "id": "root",
  "version": "0.6.0",
  "type": "Behaviors",
  "attrs": {
    "title": "\"Behaviors example\""
  },
  "children": [
    {
      "id": "workspacePanel",
      "type": "SurfaceContainers",
      "attrs": {
        "[title]": "\"Workspace\""
      }
    },
    {
      "id": "panelCollapsible",
      "type": "Collapsible",
      "attrs": {
        "[target]": "\"workspacePanel\""
      }
    },
    {
      "id": "panelResizable",
      "type": "Resizable",
      "attrs": {
        "[target]": "\"workspacePanel\""
      }
    },
    {
      "id": "panelDnd",
      "type": "DragAndDrop",
      "attrs": {
        "[target]": "\"workspacePanel\""
      }
    },
    {
      "id": "searchQuery",
      "type": "TextInputs",
      "attrs": {
        "[label]": "\"Search\"",
        "[value]": "query"
      }
    },
    {
      "id": "searchCompletion",
      "type": "InputAssistance",
      "attrs": {
        "[target]": "\"searchQuery\""
      }
    },
    {
      "id": "workspaceFocus",
      "type": "ViewportAndFocusControl",
      "attrs": {
        "[target]": "\"workspacePanel\""
      }
    },
    {
      "id": "workspaceModality",
      "type": "ModalOverlay",
      "attrs": {
        "[target]": "\"workspacePanel\""
      }
    }
  ]
}
