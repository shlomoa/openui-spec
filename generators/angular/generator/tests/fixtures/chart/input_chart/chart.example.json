{
  "id": "root",
  "version": "0.9.0",
  "type": "Chart",
  "attrs": {
    "title": "\"Chart example\""
  },
  "children": [
    {
      "id": "revenueChart",
      "type": "Chart",
      "attrs": {
        "uses.chartType": "\"bar\"",
        "uses.series": "revenueSeries",
        "uses.xAxis": "\"month\"",
        "uses.yAxis": "\"revenue\"",
        "uses.legend": true,
        "uses.tooltip": true,
        "uses.loading": "isLoading",
        "uses.error": "loadError",
        "uses.ariaLabel": "\"Monthly revenue bar chart\""
      },
      "children": [
        {
          "id": "chartEmpty",
          "type": "FeedbackWidgets",
          "attrs": {
            "uses.message": "\"No data to chart.\""
          }
        }
      ]
    }
  ]
}
