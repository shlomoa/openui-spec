{
  "id": "root",
  "version": "0.13.0",
  "type": "LinkAndScrollControls",
  "attrs": {
    "title": "\"Link and scroll controls example\""
  },
  "children": [
    {
      "id": "skipToContent",
      "type": "LinkAndScrollControls",
      "attrs": {
        "uses.label": "\"Skip to content\"",
        "uses.href": "\"#main\"",
        "produces.activate": "scrollToMain()"
      }
    },
    {
      "id": "contentScrollbar",
      "type": "LinkAndScrollControls",
      "attrs": {
        "uses.value": "scrollPosition",
        "uses.min": "0",
        "uses.max": "1000",
        "uses.orientation": "\"vertical\""
      }
    }
  ]
}
