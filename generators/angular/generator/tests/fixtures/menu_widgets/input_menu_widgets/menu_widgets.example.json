{
  "id": "root",
  "version": "0.12.0",
  "type": "MenuWidgets",
  "attrs": {
    "title": "\"Menu widgets example\""
  },
  "children": [
    {
      "id": "rowActionsMenu",
      "type": "MenuWidgets",
      "attrs": {
        "uses.label": "\"Row actions\"",
        "uses.open": "isMenuOpen",
        "produces.select": "onMenuSelect($event)",
        "uses.anchor": "\"rowActionsButton\"",
        "uses.orientation": "\"vertical\""
      },
      "children": [
        {
          "id": "editItem",
          "type": "menuitem",
          "attrs": {
            "uses.label": "\"Edit\""
          }
        },
        {
          "id": "deleteItem",
          "type": "menuitem",
          "attrs": {
            "uses.label": "\"Delete\""
          }
        }
      ]
    },
    {
      "id": "rowActionsButton",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Row actions\""
      }
    },
    {
      "id": "menubar",
      "type": "MenuWidgets"
    },
    {
      "id": "menuItem",
      "type": "MenuWidgets"
    }
  ]
}
