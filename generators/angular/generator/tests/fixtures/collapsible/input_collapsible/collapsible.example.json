{
  "id": "root",
  "version": "0.12.0",
  "type": "Collapsible",
  "attrs": {
    "title": "\"Collapsible example\""
  },
  "children": [
    {
      "id": "detailsSection",
      "type": "section",
      "attrs": {
        "text": "\"Collapsible content\""
      }
    },
    {
      "id": "detailsTrigger",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Show details\""
      }
    },
    {
      "id": "detailsCollapsible",
      "type": "Collapsible",
      "attrs": {
        "uses.target": "\"detailsSection\"",
        "uses.trigger": "\"detailsTrigger\"",
        "uses.expanded": "false",
        "produces.expandedChange": "onDetailsToggle($event)"
      }
    }
  ]
}
