{
  "id": "root",
  "version": "0.2.0",
  "type": "Application",
  "attrs": {
    "size": "\"1960x1080\""
  },
  "children": [
    {
      "id": "appRouting",
      "type": "Routing",
      "attrs": {
        "[defaultRoute]": "\"dashboardRoute\""
      },
      "children": [
        {
          "id": "dashboardRoute",
          "type": "Route",
          "attrs": {
            "[path]": "\"dashboard\"",
            "[target]": "\"dashboardPage\"",
            "[title]": "\"Dashboard\""
          }
        },
        {
          "id": "ordersRoute",
          "type": "Route",
          "attrs": {
            "[path]": "\"orders\"",
            "[target]": "\"ordersReport\"",
            "[title]": "\"Orders\""
          }
        }
      ]
    },
    {
      "id": "appNavigation",
      "type": "Navigation",
      "attrs": {
        "[ariaLabel]": "\"Primary\""
      },
      "children": [
        {
          "id": "navDashboard",
          "type": "NavItem",
          "attrs": {
            "[label]": "\"Dashboard\"",
            "[route]": "\"dashboardRoute\"",
            "[icon]": "\"dashboard\""
          }
        },
        {
          "id": "navOrders",
          "type": "NavItem",
          "attrs": {
            "[label]": "\"Orders\"",
            "[route]": "\"ordersRoute\""
          }
        }
      ]
    },
    {
      "id": "appToolbar",
      "type": "ToolBar",
      "attrs": {
        "[ariaLabel]": "\"Order commands\""
      },
      "children": [
        {
          "id": "appToolbarRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "newOrderAction",
              "type": "ToolAction",
              "attrs": {
                "[label]": "\"New order\"",
                "[icon]": "\"add\"",
                "(activate)": "onNewOrder()"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "dashboardPage",
      "type": "DashboardPage"
    },
    {
      "id": "ordersReport",
      "type": "Report",
      "attrs": {
        "title": "\"Orders\"",
        "[readOnly]": "true"
      },
      "children": [
        {
          "id": "ordersTable",
          "type": "table",
          "attrs": {
            "[data]": "orders"
          },
          "children": [
            {
              "id": "colOrderId",
              "type": "Table",
              "attrs": {
                "[field]": "\"id\"",
                "[header]": "\"Order\"",
                "[sortable]": "true"
              }
            }
          ]
        }
      ]
    }
  ]
}
