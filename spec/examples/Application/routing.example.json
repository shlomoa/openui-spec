{
  "id": "root",
  "version": "0.3.0",
  "type": "Application",
  "children": [
    {
      "id": "appRouting",
      "type": "Routing",
      "attrs": {
        "[defaultRoute]": "\"dashboardRoute\""
      },
      "children": [
        {
          "id": "dashboardRoute",
          "type": "Route",
          "attrs": {
            "[path]": "\"dashboard\"",
            "[target]": "\"dashboardPage\"",
            "[title]": "\"Dashboard\"",
            "[access]": "\"authenticated\""
          }
        },
        {
          "id": "reportRoute",
          "type": "Route",
          "attrs": {
            "[path]": "\"reports\"",
            "[target]": "\"reportPage\"",
            "[title]": "\"Reports\"",
            "[access]": "\"report-reader\""
          }
        },
        {
          "id": "fallbackRoute",
          "type": "Route",
          "attrs": {
            "[path]": "\"**\"",
            "[redirectTo]": "\"dashboardRoute\""
          }
        }
      ]
    },
    {
      "id": "dashboardPage",
      "type": "DashboardPage"
    },
    {
      "id": "reportPage",
      "type": "Report"
    }
  ]
}
