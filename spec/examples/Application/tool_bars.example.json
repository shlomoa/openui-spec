{
  "id": "root",
  "version": "0.13.0",
  "type": "Application",
  "children": [
    {
      "id": "appToolbar",
      "type": "ToolBar",
      "attrs": {
        "uses.ariaLabel": "\"Application commands\""
      },
      "children": [
        {
          "id": "primaryRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "newAction",
              "type": "ToolAction",
              "attrs": {
                "uses.label": "\"New\"",
                "uses.icon": "\"add\"",
                "produces.activate": "createNew()"
              }
            },
            {
              "id": "saveAction",
              "type": "ToolAction",
              "attrs": {
                "uses.label": "\"Save\"",
                "uses.icon": "\"save\"",
                "produces.activate": "save()"
              }
            }
          ]
        },
        {
          "id": "secondaryRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "deleteAction",
              "type": "ToolAction",
              "attrs": {
                "uses.label": "\"Delete\"",
                "uses.icon": "\"delete\"",
                "uses.disabled": "true",
                "produces.activate": "deleteSelected()"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "contextToolbar",
      "type": "ToolBars",
      "attrs": {
        "uses.ariaLabel": "\"Selection commands\""
      },
      "children": [
        {
          "id": "contextRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "duplicateAction",
              "type": "ToolAction",
              "attrs": {
                "uses.label": "\"Duplicate\"",
                "uses.icon": "\"content_copy\"",
                "produces.activate": "duplicateSelected()"
              }
            }
          ]
        }
      ]
    }
  ]
}
