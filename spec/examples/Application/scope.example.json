{
  "id": "root",
  "version": "0.2.0",
  "type": "Application",
  "children": [
    {
      "id": "appHost",
      "type": "html",
      "attrs": {
        "[lang]": "\"en\"",
        "[dir]": "\"ltr\"",
        "[title]": "\"Application bootstrap example\""
      },
      "children": [
        {
          "id": "documentHead",
          "type": "head"
        },
        {
          "id": "documentBody",
          "type": "body"
        }
      ]
    },
    {
      "id": "appFavicon",
      "type": "link",
      "attrs": {
        "[rel]": "\"icon\"",
        "[href]": "\"/favicon.ico\""
      }
    },
    {
      "id": "appRouting",
      "type": "Routing",
      "attrs": {
        "[defaultRoute]": "\"homeRoute\""
      },
      "children": [
        {
          "id": "homeRoute",
          "type": "Route",
          "attrs": {
            "[path]": "\"home\"",
            "[target]": "\"homePage\"",
            "[title]": "\"Home\""
          }
        }
      ]
    },
    {
      "id": "appNavigation",
      "type": "Navigation",
      "attrs": {
        "[ariaLabel]": "\"Primary\""
      },
      "children": [
        {
          "id": "navHome",
          "type": "NavItem",
          "attrs": {
            "[label]": "\"Home\"",
            "[route]": "\"homeRoute\"",
            "[icon]": "\"home\""
          }
        }
      ]
    },
    {
      "id": "appToolbar",
      "type": "ToolBar",
      "attrs": {
        "[ariaLabel]": "\"Application commands\""
      },
      "children": [
        {
          "id": "toolbarRow",
          "type": "ToolBarRow",
          "children": [
            {
              "id": "helpAction",
              "type": "ToolAction",
              "attrs": {
                "[label]": "\"Help\"",
                "[icon]": "\"help\"",
                "(activate)": "openHelp()"
              }
            },
            {
              "id": "homePage",
              "type": "EmptyPage"
            }
          ]
        }
      ]
    }
  ]
}
