{
  "id": "root",
  "version": "0.2.0",
  "type": "Application",
  "children": [
    {
      "id": "homeRoute",
      "type": "Route",
      "attrs": {
        "[path]": "\"home\"",
        "[target]": "\"homePage\"",
        "[title]": "\"Home\""
      }
    },
    {
      "id": "reportsRoute",
      "type": "Route",
      "attrs": {
        "[path]": "\"reports\"",
        "[target]": "\"reportsPage\"",
        "[title]": "\"Reports\""
      }
    },
    {
      "id": "primaryNav",
      "type": "Navigation",
      "attrs": {
        "[ariaLabel]": "\"Primary\""
      },
      "children": [
        {
          "id": "navHome",
          "type": "NavItem",
          "attrs": {
            "[label]": "\"Home\"",
            "[route]": "\"homeRoute\"",
            "[icon]": "\"home\""
          }
        },
        {
          "id": "navReportsGroup",
          "type": "NavGroup",
          "attrs": {
            "[label]": "\"Reports\"",
            "[expanded]": "true"
          },
          "children": [
            {
              "id": "navSalesReport",
              "type": "NavItem",
              "attrs": {
                "[label]": "\"Sales\"",
                "[route]": "\"reportsRoute\""
              }
            },
            {
              "id": "navAuditReport",
              "type": "NavItem",
              "attrs": {
                "[label]": "\"Audit\"",
                "[route]": "\"reportsRoute\"",
                "[disabled]": "true"
              }
            }
          ]
        },
        {
          "id": "navAdmin",
          "type": "NavItem",
          "attrs": {
            "[label]": "\"Administration\"",
            "[route]": "\"homeRoute\"",
            "[icon]": "\"settings\""
          }
        }
      ]
    },
    {
      "id": "homePage",
      "type": "EmptyPage"
    },
    {
      "id": "reportsPage",
      "type": "Report"
    }
  ]
}
