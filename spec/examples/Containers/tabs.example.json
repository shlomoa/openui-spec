{
  "id": "root",
  "version": "0.10.0",
  "type": "Tabs",
  "attrs": {
    "title": "\"Tabs example\""
  },
  "children": [
    {
      "id": "detailTabs",
      "type": "Tabs",
      "attrs": {
        "uses.selectedIndex": 0,
        "produces.selectedTabChange": "onTabChange($event)"
      },
      "children": [
        {
          "id": "overviewTab",
          "type": "tab",
          "children": [
            {
              "id": "overviewPanel",
              "type": "section",
              "attrs": {
                "text": "\"Overview content\""
              }
            }
          ]
        },
        {
          "id": "historyTab",
          "type": "tab",
          "children": [
            {
              "id": "historyPanel",
              "type": "section",
              "attrs": {
                "text": "\"History content\""
              }
            }
          ]
        },
        {
          "id": "auditTab",
          "type": "tab"
        }
      ]
    },
    {
      "id": "pageStack",
      "type": "Tabs",
      "children": [
        {
          "id": "pageStackPage",
          "type": "tab"
        }
      ]
    }
  ]
}
