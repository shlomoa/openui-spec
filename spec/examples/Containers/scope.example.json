{
  "id": "root",
  "version": "0.2.0",
  "type": "Containers",
  "attrs": {
    "title": "\"Containers example\""
  },
  "children": [
    {
      "id": "layoutGrid",
      "type": "Grid",
      "attrs": {
        "[columns]": "12",
        "[responsive]": "true"
      },
      "children": [
        {
          "id": "mainItem",
          "type": "section",
          "attrs": {
            "[colSpan]": "8"
          },
          "children": [
            {
              "id": "detailTabs",
              "type": "Tabs",
              "attrs": {
                "[selectedIndex]": "0"
              },
              "children": [
                {
                  "id": "overviewTab",
                  "type": "tab",
                  "attrs": {
                    "[label]": "\"Overview\""
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sideItem",
          "type": "section",
          "attrs": {
            "[colSpan]": "4"
          },
          "children": [
            {
              "id": "filtersPanel",
              "type": "ExpandablePanels",
              "attrs": {
                "[heading]": "\"Filters\"",
                "[expanded]": "true"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "summaryCard",
      "type": "SurfaceContainers",
      "attrs": {
        "[label]": "\"Summary\"",
        "[elevation]": "2"
      }
    },
    {
      "id": "filterSheet",
      "type": "SheetContainers",
      "attrs": {
        "[position]": "\"bottom\"",
        "[open]": "showFilters"
      }
    },
    {
      "id": "helpOverlay",
      "type": "OverlayContainers",
      "attrs": {
        "[anchor]": "\"helpButton\"",
        "[open]": "showHelp"
      }
    },
    {
      "id": "mainArticle",
      "type": "StructuralContainers",
      "attrs": {
        "[role]": "\"article\""
      }
    },
    {
      "id": "workspaceSplitter",
      "type": "Splitters",
      "attrs": {
        "[orientation]": "\"horizontal\"",
        "[position]": "320"
      }
    }
  ]
}
