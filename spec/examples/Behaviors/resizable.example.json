{
  "id": "root",
  "version": "0.14.0",
  "type": "Resizable",
  "attrs": {
    "title": "\"Resizable example\""
  },
  "children": [
    {
      "id": "resizablePanel",
      "type": "SurfaceContainers",
      "attrs": {
        "uses.title": "\"Resizable panel\""
      }
    },
    {
      "id": "panelResize",
      "type": "Resizable",
      "attrs": {
        "uses.target": "\"resizablePanel\"",
        "uses.axis": "\"both\"",
        "produces.resize": "onPanelResize($event)"
      }
    }
  ]
}
