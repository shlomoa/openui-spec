{
  "id": "root",
  "version": "0.13.0",
  "type": "DragAndDrop",
  "attrs": {
    "title": "\"Drag and drop example\""
  },
  "children": [
    {
      "id": "taskBoard",
      "type": "StructuralContainers",
      "children": [
        {
          "id": "todoColumn",
          "type": "StructuralContainers",
          "attrs": {
            "uses.ariaLabel": "\"To do\""
          },
          "children": [
            {
              "id": "taskCard",
              "type": "SurfaceContainers",
              "attrs": {
                "uses.title": "\"Write the spec\""
              }
            }
          ]
        },
        {
          "id": "doneColumn",
          "type": "StructuralContainers",
          "attrs": {
            "uses.ariaLabel": "\"Done\""
          }
        }
      ]
    },
    {
      "id": "taskBoardDragAndDrop",
      "type": "DragAndDrop",
      "attrs": {
        "uses.target": "\"taskBoard\"",
        "uses.dropEffect": "\"move\"",
        "uses.disabled": "isBoardLocked",
        "produces.drop": "onTaskDrop($event)"
      }
    }
  ]
}
