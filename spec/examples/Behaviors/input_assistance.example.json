{
  "id": "root",
  "version": "0.6.0",
  "type": "InputAssistance",
  "attrs": {
    "title": "\"Input assistance example\""
  },
  "children": [
    {
      "id": "emailField",
      "type": "TextInputs",
      "attrs": {
        "uses.label": "\"E-mail\"",
        "uses.value": "email",
        "produces.valueChange": "onEmailChange($event)"
      }
    },
    {
      "id": "emailCompletion",
      "type": "InputAssistance",
      "attrs": {
        "uses.target": "\"emailField\""
      }
    }
  ]
}
