{
  "id": "root",
  "version": "0.13.0",
  "type": "ModalOverlay",
  "attrs": {
    "title": "\"Modal overlay example\""
  },
  "children": [
    {
      "id": "confirmDeleteDialog",
      "type": "Dialog",
      "attrs": {
        "uses.open": "isConfirmOpen",
        "uses.modal": "true",
        "produces.close": "onConfirmClose($event)"
      },
      "children": [
        {
          "id": "confirmDeleteTitle",
          "type": "header",
          "attrs": {
            "text": "\"Delete file?\""
          }
        },
        {
          "id": "confirmDeleteText",
          "type": "section",
          "attrs": {
            "text": "\"This cannot be undone.\""
          }
        },
        {
          "id": "confirmDeleteActions",
          "type": "footer",
          "children": [
            {
              "id": "cancelDeleteButton",
              "type": "ActionControls",
              "attrs": {
                "uses.label": "\"Cancel\""
              }
            }
          ]
        }
      ]
    },
    {
      "id": "modalInteraction",
      "type": "ModalOverlay",
      "attrs": {
        "uses.target": "\"confirmDeleteDialog\""
      }
    },
    {
      "id": "confirmDeleteModal",
      "type": "ModalOverlay",
      "attrs": {
        "uses.target": "\"confirmDeleteDialog\"",
        "uses.initialFocus": "\"cancelDeleteButton\"",
        "uses.restoreFocus": "true",
        "uses.dismissOnEscape": "true",
        "produces.dismissRequest": "onDismissRequest($event)"
      }
    }
  ]
}
