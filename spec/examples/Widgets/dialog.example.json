{
  "id": "root",
  "version": "0.7.0",
  "type": "Dialog",
  "attrs": {
    "title": "\"Dialog example\""
  },
  "children": [
    {
      "id": "confirmDialog",
      "type": "Dialog",
      "attrs": {
        "uses.modal": true,
        "uses.open": "isOpen",
        "uses.ariaLabel": "\"Confirm deletion\"",
        "uses.restoreFocus": true,
        "produces.close": "onClose($event)",
        "produces.cancel": "onCancel($event)"
      },
      "children": [
        {
          "id": "dialogTitle",
          "type": "header",
          "attrs": {
            "text": "\"Delete item?\""
          }
        },
        {
          "id": "dialogContent",
          "type": "section",
          "attrs": {
            "text": "\"This action cannot be undone.\""
          }
        },
        {
          "id": "dialogActions",
          "type": "footer",
          "children": [
            {
              "id": "cancelDialog",
              "type": "ActionControls",
              "attrs": {
                "text": "\"Cancel\"",
                "produces.click": "close('cancel')"
              }
            },
            {
              "id": "confirmDelete",
              "type": "ActionControls",
              "attrs": {
                "text": "\"Delete\"",
                "produces.click": "close('confirm')"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "progressDialog",
      "type": "Dialog",
      "children": [
        {
          "id": "progressDialogContent",
          "type": "section",
          "children": [
            {
              "id": "progressDialogIndicator",
              "type": "StatusIndicator"
            }
          ]
        }
      ]
    }
  ]
}
