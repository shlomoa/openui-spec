{
  "id": "root",
  "version": "0.12.0",
  "type": "Table",
  "attrs": {
    "title": "\"Table example\""
  },
  "children": [
    {
      "id": "ordersTable",
      "type": "table",
      "attrs": {
        "behaves.sort": "sortOrders($event)",
        "behaves.filter": "filterOrders($event)",
        "behaves.paginate": "paginateOrders($event)"
      },
      "children": [
        {
          "id": "ordersTableCaption",
          "type": "caption",
          "attrs": {
            "text": "\"Open orders\""
          }
        },
        {
          "id": "ordersTableHeader",
          "type": "thead"
        },
        {
          "id": "ordersTableRow",
          "type": "tr"
        }
      ]
    }
  ]
}
