{
  "id": "root",
  "version": "0.12.0",
  "type": "FeedbackWidgets",
  "attrs": {
    "title": "\"Feedback widgets example\""
  },
  "children": [
    {
      "id": "saveFeedback",
      "type": "FeedbackWidgets",
      "attrs": {
        "uses.message": "\"Saved successfully.\"",
        "uses.severity": "\"success\"",
        "uses.duration": "4000",
        "produces.close": "onSaveFeedbackClose()"
      }
    },
    {
      "id": "saveButton",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Save\""
      }
    },
    {
      "id": "saveTooltip",
      "type": "FeedbackWidgets",
      "attrs": {
        "uses.message": "\"Saves the draft.\"",
        "uses.anchor": "\"saveButton\""
      }
    },
    {
      "id": "contextualHelp",
      "type": "FeedbackWidgets"
    },
    {
      "id": "startupScreen",
      "type": "FeedbackWidgets"
    },
    {
      "id": "illustratedMessage",
      "type": "FeedbackWidgets"
    }
  ]
}
