{
  "id": "root",
  "version": "0.6.0",
  "type": "DateTimePickers",
  "attrs": {
    "title": "\"Date/time picker example\""
  },
  "children": [
    {
      "id": "appointmentPicker",
      "type": "DateTimePicker",
      "attrs": {
        "[start]": "appointmentStart",
        "[end]": "appointmentEnd",
        "(dateChange)": "onDateChange($event)"
      }
    },
    {
      "id": "dateField",
      "type": "DateTimePicker"
    },
    {
      "id": "timeField",
      "type": "DateTimePicker"
    },
    {
      "id": "dateAndTimeField",
      "type": "DateTimePicker"
    }
  ]
}
