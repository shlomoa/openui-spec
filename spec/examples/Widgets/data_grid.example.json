{
  "id": "root",
  "version": "0.13.0",
  "type": "DataGrid",
  "attrs": {
    "title": "\"Data grid example\""
  },
  "children": [
    {
      "id": "ordersGrid",
      "type": "DataGrid",
      "attrs": {
        "uses.data": "orders",
        "uses.selection": "\"multiple\"",
        "behaves.sort": null,
        "produces.selectionChange": "onOrderSelection($event)",
        "uses.editable": "true",
        "uses.resizableColumns": "true",
        "uses.reorderableColumns": "true",
        "behaves.filter": "filterOrders($event)",
        "behaves.paginate": "paginateOrders($event)"
      },
      "children": [
        {
          "id": "ordersGridHeader",
          "type": "thead"
        },
        {
          "id": "ordersGridRow",
          "type": "tr"
        }
      ]
    },
    {
      "id": "treeGrid",
      "type": "DataGrid"
    }
  ]
}
