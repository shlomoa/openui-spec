{
  "id": "root",
  "version": "0.11.0",
  "type": "Widgets",
  "attrs": {
    "title": "\"Widgets example\""
  },
  "children": [
    {
      "id": "salesChart",
      "type": "Chart",
      "attrs": {
        "uses.kind": "\"comparison\"",
        "uses.series": "salesSeries",
        "uses.title": "\"Sales by month\""
      }
    },
    {
      "id": "salesTable",
      "type": "table"
    },
    {
      "id": "ordersGrid",
      "type": "DataGrid",
      "attrs": {
        "behaves.sort": null
      }
    },
    {
      "id": "recentList",
      "type": "List",
      "children": [
        {
          "id": "recentItem",
          "type": "li"
        }
      ]
    },
    {
      "id": "saveFeedback",
      "type": "FeedbackWidgets",
      "attrs": {
        "uses.message": "\"Saved successfully.\""
      }
    },
    {
      "id": "productMedia",
      "type": "MediaWidgets",
      "attrs": {
        "uses.src": "\"/media/product.mp4\"",
        "uses.controls": true
      }
    },
    {
      "id": "sectionNavigation",
      "type": "NavigationWidgets",
      "attrs": {
        "uses.ariaLabel": "\"Sections\""
      }
    },
    {
      "id": "rowActionsMenu",
      "type": "MenuWidgets",
      "attrs": {
        "uses.label": "\"Row actions\"",
        "uses.open": "isMenuOpen"
      }
    },
    {
      "id": "rangePicker",
      "type": "DateTimePicker"
    },
    {
      "id": "wizard",
      "type": "Stepper",
      "attrs": {
        "uses.linear": true
      },
      "children": [
        {
          "id": "stepOne",
          "type": "step"
        }
      ]
    },
    {
      "id": "infoDialog",
      "type": "Dialog",
      "attrs": {
        "uses.modal": true,
        "uses.open": "showInfo"
      },
      "children": [
        {
          "id": "infoTitle",
          "type": "header",
          "attrs": {
            "text": "\"Info\""
          }
        },
        {
          "id": "infoDialogDialogContent",
          "type": "section"
        }
      ]
    },
    {
      "id": "fileUpload",
      "type": "Widgets"
    },
    {
      "id": "filterBar",
      "type": "Widgets"
    },
    {
      "id": "valueHelp",
      "type": "Widgets"
    },
    {
      "id": "personalizationPanel",
      "type": "Widgets"
    },
    {
      "id": "planningCalendar",
      "type": "Widgets"
    }
  ]
}
