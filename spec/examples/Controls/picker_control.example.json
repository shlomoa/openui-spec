{
  "id": "root",
  "version": "0.10.0",
  "type": "PickerControl",
  "attrs": {
    "title": "\"Picker control example\""
  },
  "children": [
    {
      "id": "accentPicker",
      "type": "PickerControl",
      "attrs": {
        "uses.label": "\"Accent color\"",
        "uses.value": "accentColor",
        "produces.valueChange": "onAccentColorChange($event)"
      }
    },
    {
      "id": "fontPicker",
      "type": "PickerControl"
    },
    {
      "id": "folderPicker",
      "type": "PickerControl"
    }
  ]
}
