{
  "id": "root",
  "version": "0.12.0",
  "type": "PickerControl",
  "attrs": {
    "title": "\"Picker control example\""
  },
  "children": [
    {
      "id": "accentPicker",
      "type": "PickerControl",
      "attrs": {
        "uses.label": "\"Accent color\"",
        "uses.value": "accentColor",
        "produces.valueChange": "onAccentColorChange($event)"
      }
    },
    {
      "id": "attachmentPicker",
      "type": "PickerControl",
      "attrs": {
        "uses.label": "\"Attachments\"",
        "uses.kind": "\"file\"",
        "uses.accept": "\"image/*,.pdf\"",
        "uses.multiple": "true",
        "uses.disabled": "isUploading",
        "produces.valueChange": "onAttachmentsChange($event)"
      }
    },
    {
      "id": "fontPicker",
      "type": "PickerControl"
    },
    {
      "id": "folderPicker",
      "type": "PickerControl"
    }
  ]
}
