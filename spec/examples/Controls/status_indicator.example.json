{
  "id": "root",
  "version": "0.13.0",
  "type": "StatusIndicator",
  "attrs": {
    "title": "\"Status indicator example\""
  },
  "children": [
    {
      "id": "syncStatus",
      "type": "StatusIndicator",
      "attrs": {
        "uses.mode": "\"indeterminate\"",
        "uses.label": "\"Syncing\""
      }
    },
    {
      "id": "diskUsage",
      "type": "StatusIndicator",
      "attrs": {
        "uses.label": "\"Disk usage\"",
        "uses.mode": "\"determinate\"",
        "uses.value": "diskUsed",
        "uses.min": "0",
        "uses.max": "100",
        "uses.severity": "\"warning\""
      }
    },
    {
      "id": "meter",
      "type": "StatusIndicator"
    },
    {
      "id": "progressMode",
      "type": "StatusIndicator"
    }
  ]
}
