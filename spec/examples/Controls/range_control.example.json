{
  "id": "root",
  "version": "0.12.0",
  "type": "RangeControl",
  "attrs": {
    "title": "\"Range control example\""
  },
  "children": [
    {
      "id": "volumeRange",
      "type": "RangeControl",
      "attrs": {
        "uses.label": "\"Volume\"",
        "uses.min": "0",
        "uses.max": "100",
        "uses.value": "volume",
        "produces.valueChange": "setVolume($event)"
      }
    },
    {
      "id": "priceRange",
      "type": "RangeControl",
      "attrs": {
        "uses.label": "\"Price\"",
        "uses.min": "0",
        "uses.max": "500",
        "uses.step": "10",
        "uses.start": "minPrice",
        "uses.end": "maxPrice",
        "uses.orientation": "\"vertical\"",
        "uses.wrapping": "false",
        "uses.disabled": "false",
        "produces.valueChange": "onPriceChange($event)"
      }
    },
    {
      "id": "rangeSlider",
      "type": "RangeControl"
    },
    {
      "id": "rotaryValueControl",
      "type": "RangeControl"
    }
  ]
}
