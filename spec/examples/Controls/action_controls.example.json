{
  "id": "root",
  "version": "0.12.0",
  "type": "ActionControls",
  "attrs": {
    "title": "\"Action controls example\""
  },
  "children": [
    {
      "id": "primaryAction",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Save\"",
        "uses.disabled": "isSaving",
        "produces.activate": "save()",
        "uses.icon": "\"save\""
      }
    },
    {
      "id": "boldToggle",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"Bold\"",
        "uses.pressed": "isBold",
        "produces.activate": "toggleBold()"
      }
    },
    {
      "id": "incrementButton",
      "type": "ActionControls",
      "attrs": {
        "uses.label": "\"+\"",
        "uses.autoRepeat": "true",
        "produces.activate": "increment()"
      }
    },
    {
      "id": "toolButton",
      "type": "ActionControls"
    }
  ]
}
