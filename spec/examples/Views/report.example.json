{
  "id": "root",
  "version": "0.12.0",
  "type": "Report",
  "attrs": {
    "title": "\"Sales report\"",
    "uses.readOnly": "true",
    "uses.loading": "isLoading",
    "uses.error": "loadError"
  },
  "children": [
    {
      "id": "reportFilters",
      "type": "ToolBar",
      "attrs": {
        "uses.fields": "\"region,period\"",
        "produces.filterChange": "onFilter($event)"
      }
    },
    {
      "id": "reportTable",
      "type": "table",
      "attrs": {
        "uses.data": "rows",
        "behaves.sort": null,
        "uses.groupBy": "\"region\""
      },
      "children": [
        {
          "id": "colRegion",
          "type": "Table",
          "attrs": {
            "uses.field": "\"region\"",
            "uses.header": "\"Region\"",
            "uses.sortable": "true"
          }
        },
        {
          "id": "colRevenue",
          "type": "Table",
          "attrs": {
            "uses.field": "\"revenue\"",
            "uses.header": "\"Revenue\"",
            "uses.sortable": "true"
          }
        }
      ]
    },
    {
      "id": "reportPaging",
      "type": "NavigationWidgets",
      "attrs": {
        "uses.pageSize": "25",
        "uses.total": "rowCount",
        "produces.pageChange": "onPage($event)"
      }
    },
    {
      "id": "reportEmpty",
      "type": "FeedbackWidgets",
      "attrs": {
        "uses.message": "\"No data for the selected filters.\""
      }
    }
  ]
}
