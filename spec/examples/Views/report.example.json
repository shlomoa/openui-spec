{
  "id": "root",
  "version": "0.10.0",
  "type": "Report",
  "attrs": {
    "title": "\"Sales report\""
  },
  "children": [
    {
      "id": "reportFilters",
      "type": "ToolBar"
    },
    {
      "id": "reportTable",
      "type": "table",
      "attrs": {
        "behaves.sort": null
      }
    },
    {
      "id": "reportPaging",
      "type": "NavigationWidgets",
      "attrs": {
        "uses.pageSize": 25,
        "uses.total": "rowCount",
        "produces.pageChange": "onPage($event)"
      }
    },
    {
      "id": "reportEmpty",
      "type": "FeedbackWidgets",
      "attrs": {
        "uses.message": "\"No data for the selected filters.\""
      }
    }
  ]
}
